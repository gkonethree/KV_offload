FILE 4 (NEW) — vllm/v1/worker/sparse_attn_backend.py
────────────────────────────────────────────────────────────────────────────────

This is your attention backend registration shim.  It wraps
BatchDecodeWithPagedKVCacheWrapper from your sparse kernel package and is
selected via the VLLM_ATTENTION_BACKEND env-var or --attention-backend flag.

See the skeleton below — fill in the import path for your kernel wrapper.

    \"\"\"
    Sparse FlashInfer attention backend for vLLM v1.

    Select with:  VLLM_ATTENTION_BACKEND=sparse_flashinfer
    or:           --attention-backend sparse_flashinfer
    \"\"\"

    from __future__ import annotations
    from typing import Any, Optional, Tuple, TYPE_CHECKING

    import torch

    from vllm.attention.backends.abstract import (
        AttentionBackend, AttentionImpl, AttentionMetadata, AttentionType,
    )

    # Your sparse kernel wrapper (adjust import path).
    from your_sparse_kernel_pkg import BatchDecodeWithPagedKVCacheWrapper

    class SparseFlashInferBackend(AttentionBackend):
        @staticmethod
        def get_name() -> str:
            return "sparse_flashinfer"

        @staticmethod
        def get_impl_cls():
            return SparseFlashInferImpl

        # ... implement get_metadata_cls, get_builder_cls etc. following
        # vllm/attention/backends/flashinfer.py as a template.

    class SparseFlashInferImpl(AttentionImpl):
        def forward(
            self,
            layer,
            query, key, value,
            kv_cache,
            attn_metadata,
            output,
        ):
            # Pull sparse selection tensors from attn_metadata
            # (your builder sets them there).
            sparse_len     = attn_metadata.sparse_len
            sparse_idx     = attn_metadata.sparse_idx
            sparse_weights = attn_metadata.sparse_weights

            return layer._wrapper.run(
                q=query,
                paged_kv_cache=kv_cache,
                sparse_len=sparse_len,
                sparse_idx=sparse_idx,
                sparse_weights=sparse_weights,
            )

Register in vllm/attention/backends/registry.py:

    _BACKEND_REGISTRY = {
        ...
        "sparse_flashinfer": "vllm.v1.worker.sparse_attn_backend.SparseFlashInferBackend",
    }

