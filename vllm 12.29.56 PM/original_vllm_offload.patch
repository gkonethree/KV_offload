This patch targets vllm @ 9a35c08.

It modifies three files in vllm/v1/worker/ and adds one new file.
Apply with:  git apply vllm_offload.patch

────────────────────────────────────────────────────────────────────────────────
FILE 1 — vllm/v1/worker/gpu_worker.py
────────────────────────────────────────────────────────────────────────────────

Add after the existing imports at the top of gpu_worker.py:

    # ---- offload_package integration ----
    try:
        from offload_package.vllm_adapter import build_orchestrator, OrchestratorConfig
        _OFFLOAD_AVAILABLE = True
    except ImportError:
        _OFFLOAD_AVAILABLE = False

Add to GPUWorker.__init__ (after self.cache_config is set):

    self.kv_orchestrator = None  # populated in initialize_cache()

Replace / augment GPUWorker.initialize_cache():

    def initialize_cache(self, kv_cache_config: KVCacheConfig) -> None:
        # --- original body (unchanged) ---
        ...existing code...

        # ---- offload_package ----------------------------------------
        if _OFFLOAD_AVAILABLE and self.vllm_config.offload_config is not None:
            oc = self.vllm_config.offload_config          # see OffloadVllmConfig below
            # kv_cache[layer_idx] is a tuple (k_tensor, v_tensor) in NHD layout.
            # Use layer 0 as the representative for the scorer norm kernel.
            k0, v0 = self.model_runner.kv_cache[0]
            self.kv_orchestrator = build_orchestrator(
                cfg=OrchestratorConfig(
                    gpu_budget_blocks=oc.gpu_budget_blocks,
                    num_cpu_slots=oc.num_cpu_slots,
                    num_staging_slots=oc.num_staging_slots,
                    interval_tokens=oc.interval_tokens,
                    page_size=self.cache_config.block_size,
                    num_layers=self.model_config.get_num_layers(
                        self.parallel_config
                    ),
                    num_kv_heads=self.model_config.get_num_kv_heads(
                        self.parallel_config
                    ),
                    head_dim=self.model_config.get_head_size(),
                    dtype=k0.dtype,
                    device=torch.device("cuda", self.local_rank),
                    kv_layout="NHD",
                    scorer_decay=oc.scorer_decay,
                    scorer_head_reduction=oc.scorer_head_reduction,
                ),
                gpu_cache_k=k0,
                gpu_cache_v=v0,
            )

